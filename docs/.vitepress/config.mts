import { existsSync, readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { withMermaid } from 'vitepress-plugin-mermaid'

// the API pages and their sidebar are generated by formal (npm run docs:api) before every build
const apiSidebarFile = resolve(__dirname, '../api/_sidebar.json')
const apiSidebar = existsSync(apiSidebarFile) ? JSON.parse(readFileSync(apiSidebarFile, 'utf-8')) : []

// one sidebar for every page but the API, in reading order: the "previous" and "next" links at the bottom of a page
// follow it, so the documentation reads from the first page to the last (StringiFor's and FLAP's layout)
const docs = [
  { text: 'Start here', items: [
    { text: 'About',        link: '/guide/' },
    { text: 'Installation', link: '/guide/installation' },
    { text: 'Quick start',  link: '/guide/quickstart' },
    { text: 'Conventions',  link: '/guide/conventions' },
  ] },
  { text: 'Tutorial', items: [
    { text: 'All chapters',          link: '/manual/tutorial/' },
    { text: '1. A document by hand', link: '/manual/tutorial/01-document' },
    { text: '2. Write an extension', link: '/manual/tutorial/02-extension' },
  ] },
  { text: 'Cookbook', items: [
    { text: 'All recipes', link: '/manual/cookbook' },
  ] },
  { text: 'Reference', items: [
    { text: 'At a glance',  link: '/reference/' },
    { text: 'The document', link: '/reference/document' },
    { text: 'Input',        link: '/reference/input' },
    { text: 'Extensions',   link: '/reference/extensions' },
    { text: 'Conformance',  link: '/reference/conformance' },
    { text: 'API',          link: '/api/' },
  ] },
  { text: 'Project', items: [
    { text: 'Contributing', link: '/guide/contributing' },
    { text: 'Changelog',    link: '/guide/changelog' },
  ] },
]

export default withMermaid({
  title: 'BARUCH',
  description: 'Bidirectional AST Reader and Unparser for CommonMark, Hookable: a pure Fortran Markdown parser and emitter, with opt-in GFM and VitePress extensions',
  base: '/BARUCH/',
  srcExclude: ['ford.md'],

  markdown: {
    math: true,
    languages: ['fortran-free-form', 'fortran-fixed-form'],
    languageAlias: {
      fortran: 'fortran-free-form',
      f90: 'fortran-free-form',
      f03: 'fortran-free-form',
      f08: 'fortran-free-form',
    },
  },

  themeConfig: {
    nav: [
      { text: 'Start',     link: '/guide/',          activeMatch: '^/guide/' },
      { text: 'Tutorial',  link: '/manual/tutorial/', activeMatch: '^/manual/tutorial/' },
      { text: 'Cookbook',  link: '/manual/cookbook', activeMatch: '^/manual/cookbook' },
      { text: 'Reference', link: '/reference/',      activeMatch: '^/reference/' },
      { text: 'API',       link: '/api/' },
      { text: 'GitHub',    link: 'https://github.com/szaghi/BARUCH' },
    ],

    sidebar: {
      '/api/': [
        { text: 'Back to the documentation', link: '/guide/' },
        { text: 'API', items: [{ text: 'Overview', link: '/api/' }] },
        ...apiSidebar,
      ],
      '/guide/': docs,
      '/manual/': docs,
      '/reference/': docs,
    },

    socialLinks: [
      { icon: 'github', link: 'https://github.com/szaghi/BARUCH' },
    ],

    search: {
      provider: 'local',
    },

    footer: {
      message: 'Released under your choice of the GPL v3, BSD-2-Clause, BSD-3-Clause or MIT license.',
      copyright: 'Copyright © 2026 Stefano Zaghi',
    },
  },

  mermaid: {},

  vite: {
    // Build with an explicit modern JS target so the docs compile regardless of
    // which mermaid/vitepress/esbuild versions npm resolves. Vite's default
    // es2020 target forces esbuild to down-level modern syntax (e.g. the
    // destructuring mermaid 11.16+ emits), which it refuses to do and the build
    // dies. es2022 needs no lowering and is within VitePress's browser floor.
    build: {
      target: 'es2022',
    },
    // The dev server pre-bundles the dependencies with its own esbuild target (es2020), ignoring build.target:
    // without this, `vitepress dev` dies on the destructuring of mark.js and @vueuse. Bundling mermaid whole also
    // covers the CJS dependencies vitepress-plugin-mermaid does not list (as SETH's configuration).
    optimizeDeps: {
      include: ['mermaid'],
      esbuildOptions: {
        target: 'es2022',
      },
    },
  },
})
